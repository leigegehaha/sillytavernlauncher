{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "tavern-deepseek-launcher",
  "productName": "Tavern Deepseek",
  "version": "2.0.2",
  "identifier": "com.tavern-deepseek-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tavern Deepseek - 酒馆启动器",
        "width": 1200,
        "height": 800,
        "center": true,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 1600,
        "maxHeight": 1000,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMDk4NzVDRENFQTk2NzQKUldSMGx1cmNYSWNKc0hZbDF2UWNuOHFYNkRkQkVGNmtDNytUREVoc3FOcHJEL3E5bXhiZHZZWSsK",
      "endpoints": [
        "https://ghfast.top/https://github.com/al01cn/sillytavern-launcher/releases/latest/download/latest.json",
        "https://gh.llkk.cc/https://github.com/al01cn/sillytavern-launcher/releases/latest/download/latest.json",
        "https://github.com/al01cn/sillytavern-launcher/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "resources": {
      "resources/sillytavern-1.18.0": "sillytavern-1.18.0",
      "resources/node": "node",
      "resources/character-cards": "character-cards",
      "resources/presets": "presets"
    },
    "copyright": "Tavern Deepseek by 磊哥哥 | Fork from SillyTavern Launcher by AL01.CN",
    "publisher": "磊哥哥",
    "license": "MIT",
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "startMenuFolder": "Tavern Deepseek",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh",
        "template": "nsis/template.nsi",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "customLanguageFiles": {
          "SimpChinese": "nsis/languages/SimpChinese.nsh",
          "English": "nsis/languages/English.nsh"
        }
      },
      "wix": null
    }
  }
}
